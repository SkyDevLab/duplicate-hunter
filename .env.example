# Duplicate Hunter Environment Variables Example
PORT=3000
BOT_PORT=3001
NODE_ENV=production

# GitHub App Authentication
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret
# Paste RSA Private Key (.pem) or escape newlines
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Database Configuration (PostgreSQL / pgvector)
# Omit or leave empty to use built-in zero-dependency local JSON storage
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/duplicate_hunter

# AI Provider Configuration (Optional)
# Options: local | openai | ollama
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://127.0.0.1:11434
